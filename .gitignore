# Build output
bin/
obj/
artifacts/
publish/
*.msi
*.wixpdb
*.wixobj
TestResults/
*.trx
*.nupkg

# Dependencies / tool caches
packages/
.nuget/
node_modules/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db
